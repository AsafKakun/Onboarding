# Copy this file to .env.local (never committed) to load employees from Airtable.
# Without a token the dashboard shows generated sample data.
#
# Token: https://airtable.com/create/tokens
#   scope: data.records:read, access: the base below.
#   The full token looks like pat<14 chars>.<64 hex chars>.
VITE_AIRTABLE_TOKEN=
VITE_AIRTABLE_BASE_ID=appmsE2WLIFOSvh82
VITE_AIRTABLE_TABLE=Onboarding Employees
